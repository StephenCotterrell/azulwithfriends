{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["/app/server migrate"],
    "startCommand": "/app/server",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "numReplicas": 1,
    "sleepApplication": false
  }
}
